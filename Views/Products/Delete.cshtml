@model WebApplication2.Models.Product

@{
    ViewBag.Title = "Delete Product";
}

<h2>Delete Product</h2>

<h4>Are you sure you want to delete this product?</h4>

<div>
    <dl class="dl-horizontal">

        <dt>Product Name</dt>
        <dd>@Model.Name</dd>

        <dt>Category</dt>
        <dd>@Model.Category</dd>

        <dt>Price</dt>
        <dd>₹ @Model.Price</dd>

        <dt>Quantity</dt>
        <dd>@Model.Quantity</dd>

    </dl>

    @using (Html.BeginForm("DeleteConfirmed", "Products", new { id = Model.Id }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <input type="submit" value="Delete" class="btn btn-danger" />

        @Html.ActionLink(
            "Cancel",
            "Index",
            null,
            new { @class = "btn btn-default" }
        )
    }
</div>